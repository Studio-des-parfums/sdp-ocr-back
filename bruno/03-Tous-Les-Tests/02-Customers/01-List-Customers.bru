meta {
  name: List Customers
  type: http
  seq: 1
  tags: [
    readonly
  ]
}

get {
  url: {{baseUrl}}/api/v1/customers?page=1&size=10
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.customers.length: gte 1
  res.body.total: isNumber
  res.body.total: gt 0
}

script:post-response {
  if (res.body.customers && res.body.customers.length > 0) {
    bru.setVar("sampleCustomerId", res.body.customers[0].id);
  }
}
