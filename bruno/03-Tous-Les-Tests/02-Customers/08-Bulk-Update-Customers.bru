meta {
  name: Bulk Update Customers
  type: http
  seq: 8
  tags: [
    mutation
  ]
}

put {
  url: {{baseUrl}}/api/v1/customers/bulk
  body: json
  auth: none
}

body:json {
  {
    "customers": [
      {
        "id": {{createdCustomerId}},
        "city": "Bordeaux"
      }
    ]
  }
}

assert {
  res.status: eq 200
  res.body.updated: isDefined
}
