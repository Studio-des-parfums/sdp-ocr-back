meta {
  name: Customer Loyalty Rate
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/analytics/customers/loyalty?min_formulas=2
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.total_customers_with_formula: isNumber
  res.body.loyal_customers: isNumber
  res.body.loyalty_rate: isNumber
}
