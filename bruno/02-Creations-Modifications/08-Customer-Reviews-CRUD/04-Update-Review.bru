meta {
  name: Update Review
  type: http
  seq: 4
  tags: [
    mutation
  ]
}

put {
  url: {{baseUrl}}/api/v1/customer-reviews/{{createdReviewId}}
  body: json
  auth: none
}

body:json {
  {
    "first_name": "ReviewBrunoUpdated"
  }
}

assert {
  res.status: eq 200
  res.body.first_name: eq ReviewBrunoUpdated
}
