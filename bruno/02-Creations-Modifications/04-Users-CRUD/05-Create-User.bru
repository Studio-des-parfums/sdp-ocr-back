meta {
  name: Create User
  type: http
  seq: 5
  tags: [
    mutation
  ]
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: none
}

body:json {
  {
    "first_name": "Bruno",
    "last_name": "TestUser",
    "email": "bruno.user.{{$timestamp}}@example.com",
    "phone": "0601020304",
    "job": "Parfumeur",
    "team": "Atelier",
    "role_id": 1
  }
}

assert {
  res.status: eq 200
  res.body.id: isNumber
}

script:post-response {
  if (res.body.id) {
    bru.setVar("createdUserId", res.body.id);
  }
}
