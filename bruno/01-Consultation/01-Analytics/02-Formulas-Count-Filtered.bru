meta {
  name: Formulas Count (Date Filtered)
  type: http
  seq: 2
  tags: [
    readonly
  ]
}

get {
  url: {{baseUrl}}/api/v1/analytics/formulas/count?date_from=2025-01-01&date_to=2025-12-31&group_by=month
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.total: isNumber
  res.body.total: gt 0
  res.body.data.length: gte 1
}
