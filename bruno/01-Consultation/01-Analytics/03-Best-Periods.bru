meta {
  name: Best Periods (Months, Days, Years)
  type: http
  seq: 3
  tags: [
    readonly
  ]
}

get {
  url: {{baseUrl}}/api/v1/analytics/formulas/best-periods?limit=5
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.top_months.length: gte 1
  res.body.top_days_of_week.length: gte 1
  res.body.top_years.length: gte 1
}
