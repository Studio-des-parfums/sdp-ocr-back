meta {
  name: Create Order
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/orders/
  body: json
  auth: none
}

body:json {
  {
    "customer_id": 69,
    "formula_id": 54,
    "comment": "Commande test automatique Bruno",
    "status": "PENDING",
    "type": "REORDER",
    "items": [
      {
        "name": "Flacon classique 50ml",
        "quantity": 1
      }
    ]
  }
}

assert {
  res.status: eq 200
  res.body.id: isNumber
}

script:post-response {
  if (res.body.id) {
    bru.setVar("createdOrderId", res.body.id);
  }
}
