meta {
  name: Update Order Status
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/orders/{{createdOrderId}}
  body: json
  auth: none
}

body:json {
  {
    "status": "CONFIRMED",
    "comment": "Commande confirmée via test Bruno"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq CONFIRMED
}
