meta {
  name: Update Formula Notes & Metadata
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/v1/formulas/54/notes
  body: json
  auth: none
}

body:json {
  {
    "comment": "Test Bruno automated update",
    "top_notes": [
      {
        "name": "Bergamote",
        "quantity": "5"
      }
    ],
    "heart_notes": [
      {
        "name": "Pivoine",
        "quantity": "10"
      }
    ],
    "base_notes": [
      {
        "name": "Vanille",
        "quantity": "15"
      }
    ]
  }
}

assert {
  res.status: eq 200
  res.body.id: eq 54
}
