meta {
  name: Generate CSV Export
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/export/generate-csv
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "data": [
      {
        "reference": "REF001",
        "first_name": "Jean",
        "last_name": "Dupont",
        "email": "jean.dupont@example.com",
        "phone": "+33612345678",
        "job": "Parfumeur",
        "city": "Grasse",
        "country": "France"
      }
    ]
  }
}

assert {
  res.status: eq 200
  res.headers["content-type"]: contains text/csv
}
