meta {
  name: Create Role
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/roles/
  body: json
  auth: none
}

body:json {
  {
    "name": "TestRole_{{$timestamp}}",
    "description": "Role créé par test Bruno automatisé"
  }
}

assert {
  res.status: eq 200
  res.body.id: isNumber
}

script:post-response {
  if (res.body.id) {
    bru.setVar("createdRoleId", res.body.id);
  }
}
