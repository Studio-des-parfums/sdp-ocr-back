meta {
  name: Create Customer
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/customers
  body: json
  auth: none
}

body:json {
  {
    "first_name": "TestBruno",
    "last_name": "Automated",
    "email": "bruno.test.{{$timestamp}}@example.com",
    "phone": "0601020304",
    "city": "Paris",
    "country": "France",
    "gender": "Homme"
  }
}

assert {
  res.status: eq 200
  res.body.id: isNumber
}

script:post-response {
  if (res.body.id) {
    bru.setVar("createdCustomerId", res.body.id);
  }
}
